generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-postgre"
}

datasource db {
  provider = "postgresql"
}

model Main_Instagram_Data {
  id               Int        @id @default(autoincrement())
  pk_def_insta     BigInt     @unique
  username         String     @unique
  fullname         String?
  is_private       Boolean
  media_post_total Int
  followers        Int
  following        Int
  biography        String?
  is_mutual        Boolean
  last_update      DateTime?  @updatedAt
  gender           Gender?
  snapshot_at      DateTime?

  relations        Relation_Status[]
  subrelations     Subrelation_Status[]
  instagram_logs   Update_Instagram_Data_Log[]
}

enum Gender {
  Male
  Female
  Unknown
}

model Relation_Status {
  id               Int       @id @default(autoincrement())
  relational       String    @unique
  text_color       String    @db.Char(7)
  bg_color         String    @db.Char(7)
  border_color     String    @db.Char(7)

  @@unique([text_color, bg_color, border_color], name: "relation_color_options")

  instagram_users   Main_Instagram_Data[]
  subrelations      Subrelation_Status[]
}

model Main_Account_Center {
  pk        Int    @id @default(1)
  id        Int
  username  String
}

model Subrelation_Status {
  id                Int      @id @default(autoincrement())
  subrelational     String

  relations_id      Int
  relations         Relation_Status @relation(fields: [relations_id], references: [id], onDelete: Cascade)

  @@unique([subrelational, relations_id], name: "subrelational_naming")
  
  instagram_users   Main_Instagram_Data[]
}

model Update_Instagram_Data_Log {
  id                Int      @id @default(autoincrement())

  instagram_id      Int
  instagram_users   Main_Instagram_Data @relation(fields: [instagram_id], references: [id], onDelete: Cascade)
  
  username          String     @unique
  fullname          String?
  is_private        Boolean
  media_post_total  Int
  followers         Int
  following         Int
  biography         String?
  update_on         DateTime
}